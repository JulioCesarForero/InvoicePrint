# Copia este archivo como .env y ajusta los valores.
# Contraseña de 'sa': mínimo 8 caracteres con mayúsculas, minúsculas y números.
# Usa solo letras y números (se inserta en la URL de conexión; evita @ : / ? # %).
MSSQL_SA_PASSWORD=CambiaEsto2026Seguro

# true = carga los datos sintéticos al crear la base por primera vez
SEED_DATA=true

# Puertos en el equipo anfitrión
APP_PORT=8050
API_PORT=8060
DB_PORT=14333

# Diagnóstico de la API
APP_DEBUG=false
SQLALCHEMY_ECHO=false
